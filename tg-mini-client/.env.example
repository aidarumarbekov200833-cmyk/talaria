# Скопируй этот файл в .env и впиши свои значения с my.telegram.org
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
PORT=3000

# Обязательный секрет server API и билетов. Должен в точности совпадать с
# TG_CLIENT_SECRET в общем .env; без него процесс не запускается.
TG_CLIENT_SECRET=

# Куда сообщать, какой Telegram вошёл в слот аккаунта. Бэкенд подпишет
# карточку в настройках сам, без ручного ввода ника.
SITE_API_URL=http://backend:8000

# Только для обновления старой установки, где сессия была одна на всех
# (sessions/session.txt). Укажите id пользователя сайта, чья это сессия.
TG_LEGACY_OWNER_ID=
