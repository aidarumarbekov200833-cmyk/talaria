# Zephyr production environment. Copy to the project root as .env.
# Never commit the filled file. The release packager includes your local .env
# only in the local archive under release/; Docker images still exclude it.

BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
BOT_USERNAME=CHANGE_ME_BOT_USERNAME
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS

POSTGRES_USER=outly
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DB_PASSWORD
POSTGRES_DB=outly
DATABASE_URL=postgresql+psycopg2://outly:CHANGE_ME_URL_ENCODED_DB_PASSWORD@db:5432/outly

API_ID=CHANGE_ME_TELEGRAM_API_ID
API_HASH=CHANGE_ME_TELEGRAM_API_HASH
TG_CLIENT_SECRET=CHANGE_ME_RANDOM_64_CHARS
TG_CLIENT_URL=http://web-tg:3000
SITE_API_URL=http://backend:8000

DOMAIN=CHANGE_ME_DOMAIN
FRONTEND_HTTP_PORT=127.0.0.1:8080
TRUSTED_PROXY_HOPS=2

ADMIN_TELEGRAM_IDS=CHANGE_ME_TELEGRAM_ID
ADMIN_USERNAME=CHANGE_ME_PUBLIC_CONTACT
ADMIN_USERNAME_FALLBACK=false
ADMIN_IP_ALLOWLIST=

AI_BASE_URL=https://freeinference.org/v1
AI_MODEL=deepseek-v4-flash
AI_API_KEY=
SENTRY_DSN=

BACKUP_KEEP_DAYS=7
RESTIC_REPO=
RESTIC_PASSWORD=
RESTIC_RSH=ssh

LOG_JSON=true
LOG_LEVEL=INFO
METRICS_TOKEN=CHANGE_ME_RANDOM_METRICS_TOKEN
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_ALERT_MIN_INTERVAL_SECONDS=300

SEND_DELAY_MIN_SECONDS=4
SEND_DELAY_MAX_SECONDS=9
TG_LEGACY_OWNER_ID=

JWT_TTL_DAYS=7
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
MAX_OFFER_IMAGE_BYTES=800000
MAX_REQUEST_BODY_BYTES=2000000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=20
RATE_LIMIT_AI=20
RATE_LIMIT_KEY_CHECK=15
RATE_LIMIT_SEARCH=30
RATE_LIMIT_TEST_SEND=10
