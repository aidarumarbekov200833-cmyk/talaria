# Скопируйте этот файл в .env и заполните значения. .env в git не попадает.

# 1) @BotFather -> /newbot -> получите токен
# 2) @BotFather -> /setdomain -> укажите домен, на котором открывается страница входа
#    (для локальной разработки: localhost). Без этого шага официальная кнопка
#    Telegram Login не отрисуется.
# Если оставить пустыми, бэкенд поднимется в демо-режиме с кнопкой «демо-вход».
BOT_TOKEN=
BOT_USERNAME=

# Подпись JWT. Замените на длинную случайную строку, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Ключ шифрования секретов в БД (ключи YouTube Data API, таблица api_keys).
# Отдельный от JWT_SECRET: тот можно ротировать, этот — нельзя без перешифровки.
# Обязателен в проде. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATA_ENCRYPTION_KEY=

DATABASE_URL=postgresql+psycopg2://outly:CHANGE_ME_URL_ENCODED_DB_PASSWORD@db:5432/outly

# Учётные данные Postgres для docker-compose. Должны совпадать с DATABASE_URL.
#
# POSTGRES_PASSWORD ОБЯЗАТЕЛЬНОЕ: docker-compose больше не подставляет молчаливый
# публичный дефолт — раньше из-за него база могла уехать в прод с паролем,
# который лежит в публичном репозитории. Сгенерируйте свой:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# и повторите его в DATABASE_URL выше.
POSTGRES_USER=outly
POSTGRES_PASSWORD=
POSTGRES_DB=outly

# Сколько дней хранить ежедневные дампы БД и архивы Telegram-сессий.
BACKUP_KEEP_DAYS=30
# Дамп обязан появляться не реже чем раз в 30 часов; раз в 7 дней он реально
# разворачивается в отдельную временную БД. Проверка считается просроченной
# через 8 дней. Эти значения используются Docker healthcheck.
BACKUP_MIN_BYTES=256
# Копия снимается каждые 6 часов (21600 c). Порог тревоги — 9 часов:
# один пропуск прощаем, два подряд означают, что бэкапы встали.
BACKUP_INTERVAL_SECONDS=21600
BACKUP_MAX_AGE_SECONDS=32400
BACKUP_VERIFY_INTERVAL_DAYS=7
BACKUP_VERIFY_MAX_AGE_SECONDS=691200
BACKUP_VERIFY_DB=outly_restore_verify
# Watchdog проверяет markers каждые 5 минут, повторяет одинаковый алерт не
# чаще раза в 6 часов и предупреждает, если свободно меньше 2 ГБ.
BACKUP_CHECK_INTERVAL_SECONDS=300
BACKUP_ALERT_REPEAT_SECONDS=21600
BACKUP_MIN_FREE_BYTES=2147483648

# Стабильные имена Docker volumes. Они не меняются при переименовании папки или
# Compose project, поэтому обновление не может незаметно подключить пустую БД.
COMPOSE_PROJECT_NAME=outly
OUTLY_PGDATA_VOLUME=outly-pgdata
OUTLY_TG_SESSIONS_VOLUME=outly-telegram-sessions
OUTLY_CADDY_DATA_VOLUME=outly-caddy-data
OUTLY_CADDY_CONFIG_VOLUME=outly-caddy-config

# --- Внешний HTTPS через Caddy (профиль tls) ---
# Домен, на котором живёт сайт. Caddy сам выпустит и продлит Let's Encrypt.
# Для локальной проверки TLS: localhost (Caddy использует свой внутренний CA).
# Запуск: docker compose --profile tls up -d
DOMAIN=

# Порт, который фронтенд (nginx) слушает, когда перед ним встаёт Caddy.
# В профиле tls Caddy публикует 80/443 наружу, а nginx должен сидеть локально.
# Пусто/по умолчанию — 80 (обычный запуск без Caddy).
FRONTEND_HTTP_PORT=127.0.0.1:8080

# --- Off-site бэкап дампов через restic (профиль offsite-backup) ---
# Куда складывать и как шифровать. Примеры:
#   RESTIC_REPO=user@backup-host:/srv/restic/outly     (через ssh)
#   RESTIC_REPO=s3:https://s3.example.com/outly        (S3-совместимо)
# RESTIC_PASSWORD — пароль шифрования репозитория (сгенерируйте случайный;
# без него снапшоты не прочитать!). RESTIC_RSH — как подключиться по ssh,
# обычно ssh -i /path/to/key. Запуск: docker compose --profile offsite-backup up -d
RESTIC_REPO=
RESTIC_PASSWORD=
RESTIC_RSH=ssh

# ИИ-помощник (OpenAI-совместимый провайдер). Это единственный источник
# настроек: в админке полей провайдера нет, ключ не попадает в БД и браузер.
# Ключ провайдера НЕ коммитьте: держите его только в вашем .env.
AI_BASE_URL=https://freeinference.org/v1
AI_MODEL=deepseek-v4-flash
AI_API_KEY=

# Изолированный Telegram gateway (tg-mini-client) и общий секрет server API.
#
# ВНИМАНИЕ: сервис web-tg в docker-compose НЕ стартует без API_ID/API_HASH —
# это твои личные ключи приложения Telegram (my.telegram.org -> API development
# tools). Они используются только на сервере (GramJS/MTProto), в браузер не
# попадают. tg-mini-client/.env.example хранит отдельную копию с той же парой.
API_ID=
API_HASH=

# Адрес Telegram gateway. Этот .env.example предназначен для основного запуска
# через docker-compose, где gateway доступен по имени сервиса web-tg.
# Для запуска backend напрямую на хосте переопределите на http://localhost:3000.
TG_CLIENT_URL=http://web-tg:3000

# Внутренний callback gateway -> backend. Снаружи Docker-сети не публикуется.
SITE_API_URL=http://backend:8000

# Общий секрет всех server API и подписанных билетов формы подключения.
# Обязателен: без него gateway завершит запуск. Сгенерируйте длинную случайную
# строку и используйте одно значение в backend и tg-mini-client.
TG_CLIENT_SECRET=

# --- Администраторы ---
# Список Telegram ID через запятую — кто имеет доступ к админке.
# Именно ID, а не username: username в Telegram можно освободить и занять
# чужим аккаунтом — тогда новый владелец имени получит админку. ID неизменен.
# Свой ID можно узнать у @userinfobot.
ADMIN_TELEGRAM_IDS=

# Публичный контакт владельца для страницы тарифов. Сам по себе прав админа
# не даёт — права выдаются только через ADMIN_TELEGRAM_IDS выше.
ADMIN_USERNAME=Cxentrall

# Только для локальной разработки. В production обязательно false.
ADMIN_USERNAME_FALLBACK=false

# --- Сеть и прокси ---
# Сколько СВОИХ прокси стоит перед бэкендом. От этого зависит, какой адрес
# из X-Forwarded-For считается настоящим IP клиента. Ошибётесь в большую
# сторону — кто угодно сможет подделать свой IP и обойти рейт-лимит.
#   1 = только nginx (запуск без Caddy) — это и дефолт приложения
#   2 = Caddy + nginx — ТОЛЬКО для профиля tls (docker-compose.prod.yml, как в проде)
#   3 = Cloudflare + Caddy + nginx
# Запускаете без Caddy — поставьте 1, иначе один поддельный X-Forwarded-For
# обходит рейт-лимиты. Значение вне 1..3 бэкенд отвергает на старте.
TRUSTED_PROXY_HOPS=2

# --- Логи ---
# LOG_JSON=true — структурные логи одной строкой JSON (удобно для сборщиков
# логов и грепа по request_id). false — обычный читаемый вид для разработки.
LOG_JSON=true
LOG_LEVEL=INFO

# У каждого слота аккаунта своя MTProto-сессия. В браузере доступна только
# форма телефон → код → 2FA по подписанному билету; диалогов и Web Telegram нет.
# Билет подписывается TG_CLIENT_SECRET выше.
#
# Переход со старой версии: раньше сессия была одна на всех
# (sessions/session.txt). Впишите сюда id пользователя сайта (колонка id в
# таблице users), и она станет его личной — заново входить в Telegram не
# придётся. Иначе просто удалите старый файл и войдите заново.
TG_LEGACY_OWNER_ID=

# --- Метрики Prometheus ---
# Токен для чтения /metrics через заголовок X-Metrics-Token. Пусто — эндпоинт
# открыт без проверки (нормально для локального Prometheus в закрытой сети).
# В проде, если /metrics доступен публично, задайте длинную случайную строку
# и укажите её же в конфиге Prometheus (scrape_configs -> authorization/headers).
METRICS_TOKEN=

# --- Алерты в Telegram ---
# Отправлять админам (ADMIN_TELEGRAM_IDS) сообщение при HTTP 5xx и необработанных
# исключениях. Использует тот же BOT_TOKEN, что и вход. false — алерты выключены.
TELEGRAM_ALERTS_ENABLED=true

# Минимальный интервал между повторными алертами с одним и тем же ключом
# (тип ошибки + путь), в секундах. Защита от спама админам при потоке одинаковых
# ошибок — уведомление уйдёт один раз за этот период, а не на каждый запрос.
TELEGRAM_ALERT_MIN_INTERVAL_SECONDS=300

# --- IP-allowlist для админки ---
# Список IP или подсетей CIDR через запятую, которым разрешён доступ к /api/admin/*
# (например: 203.0.113.10,198.51.100.0/24). Пусто — ограничения нет (доступ по
# админскому username/ID, как раньше). Учитывает TRUSTED_PROXY_HOPS при определении
# настоящего IP клиента.
ADMIN_IP_ALLOWLIST=

# --- Паузы между сообщениями рассылки ---
# Глобальный переключатель пауз. При MAX > 0 рабочий диапазон задаётся отдельно
# для каждого аккаунта в интерфейсе (по умолчанию 20–60 с). MAX=0 полностью
# отключает ожидание — только для тестов и локальной отладки.
SEND_DELAY_MIN_SECONDS=4
SEND_DELAY_MAX_SECONDS=9

# --- Полные настройки runtime (обычно оставляют как есть) ---
JWT_TTL_DAYS=7
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
MAX_OFFER_IMAGE_BYTES=800000
MAX_REQUEST_BODY_BYTES=2000000
SENTRY_DSN=

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=20
RATE_LIMIT_AI=20
RATE_LIMIT_KEY_CHECK=15
RATE_LIMIT_SEARCH=30
RATE_LIMIT_TEST_SEND=10
# Основной домен и его алиасы (www, старый адрес) — алиасы редиректятся на PRIMARY_DOMAIN.
PRIMARY_DOMAIN=
ALIAS_DOMAINS=
